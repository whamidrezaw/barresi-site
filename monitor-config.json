{
  "_راهنما": "توضیح همهٔ تنظیمات در README.md است. کلیدهایی که با _ شروع می‌شوند فقط توضیح هستند و نادیده گرفته می‌شوند.",

  "telegram": {
    "token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_ids": ["YOUR_CHAT_ID"],
    "proxy": null,
    "commands": true
  },

  "timezone": "Asia/Tehran",
  "daily_report_hour": 9,
  "notify_startup": true,
  "history_days": 30,

  "browser": {
    "headless": true,
    "channel": "chrome",
    "max_pages": 2,
    "block_resources": true
  },

  "defaults": {
    "engine": "auto",
    "interval_seconds": 120,
    "jitter_seconds": 15,
    "timeout_seconds": 30,
    "error_threshold": 3,
    "cooldown_minutes": 0
  },

  "watches": [
    {
      "id": "de_embassy_home",
      "name": "سفارت آلمان (تهران) — صفحه اصلی و همهٔ صفحات فارسی",
      "url": "https://teheran.diplo.de/ir-fa",
      "selector": "#main",
      "track_links": true,
      "interval_seconds": 90,
      "keywords": ["ویزا", "روادید", "نوبت", "وقت سفارت", "visa", "termin", "appointment"],
      "crawl": {
        "include": ["teheran\\.diplo\\.de/ir-fa/"],
        "max_pages": 150,
        "max_depth": 3,
        "interval_seconds": 900
      }
    },
    {
      "id": "de_embassy_visa_status",
      "name": "سفارت آلمان — وضعیت بخش ویزا و نوبت‌دهی (صفحهٔ آلمانی)",
      "url": "https://teheran.diplo.de/ir-de/2752046-2752046",
      "selector": "#main",
      "track_links": true,
      "interval_seconds": 60,
      "keywords": ["Termin", "Visum", "Visa", "Bearbeitungszeit", "TLScontact"]
    },
    {
      "id": "bbc_persian_rss",
      "name": "اخبار BBC فارسی (RSS)",
      "type": "feed",
      "url": "https://feeds.bbci.co.uk/persian/rss.xml",
      "interval_seconds": 60,
      "enabled": false
    },
    {
      "id": "telegram_channel",
      "name": "کانال تلگرام BBC فارسی",
      "type": "items",
      "url": "https://t.me/s/bbcpersian",
      "item_selector": ".tgme_widget_message_wrap",
      "item_link_selector": "a.tgme_widget_message_date",
      "exclude_selectors": [".tgme_widget_message_author", ".tgme_widget_message_views", ".copyonly",
                            ".message_media_not_supported_wrap", ".message_video_duration"],
      "interval_seconds": 60,
      "enabled": false
    }
  ]
}
